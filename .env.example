# The assistant reads the nearest .env (searching up from the current folder).
ANTHROPIC_API_KEY=sk-ant-...
# Shared cost ledger from agent-cost-tracker, and its hard budget in USD.
COST_DB_PATH=./costs.sqlite
COST_BUDGET_USD=15
# Optional: pin a release from config/releases.yaml (this is the rollback switch).
# SKA_RELEASE=2026-10-r1
# Optional: where the index and the audit log live.
# SKA_INDEX_DIR=./index
# SKA_AUDIT_DB=./logs/audit.sqlite
